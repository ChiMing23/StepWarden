# BigWigsMods/packager 元数据
# 放在仓库根目录，也就是 StepWarden.toc 所在的同一层

package-as: StepWarden

# 不进入发布包的文件
ignore:
  - .gitignore
  - .gitattributes
  - .github
  - docs
  - '*.bak'
  - '*.merged'
  - '*.ps1'
  - '*.py'
  - __MACOSX
  - .DS_Store

# 从 CHANGELOG.md 读取更新日志，发布时自动填入 Release 说明
# 该文件本身不会被打进 zip
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# 本插件没有依赖库，不生成 nolib 版本
